APP_NAME=Cordial API
ENV=development
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=cordial
JWT_SECRET=change-me-in-dev
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=10080
FRONTEND_ORIGINS=http://localhost:5174,http://127.0.0.1:5174
SHOW_DEV_OTP=true
OTP_REQUEST_LIMIT=5
OTP_VERIFY_LIMIT=10
OTP_RATE_WINDOW_MINUTES=15
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Cordial
SMTP_USE_TLS=true
SMTP_USE_SSL=false
